{
  "name": "@ats-perfect-ventures/naukri-recruiter-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright-based Naukri Recruiter login and authenticated API access",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "login": "tsx src/scripts/login.ts",
    "test-api": "tsx src/scripts/test-api.ts",
    "google-oauth-setup": "tsx src/scripts/google-oauth-setup.ts",
    "download-resdex": "tsx src/scripts/download-resdex.ts",
    "postinstall": "playwright install chromium",
    "save-session": "tsx src/resdex/saveSession.ts",
    "scan":         "tsx src/resdex/scanProfileLinks.ts",
    "download":     "tsx src/resdex/downloadFromScan.ts",
    "chrome": "taskkill /F /IM chrome.exe & \"C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe\" --remote-debugging-port=9222 --no-first-run",
    "run-manual": "tsx src/scripts/run-manual.ts"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "fs-extra": "^11.2.0",
    "playwright": "^1.49.1",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18"
  }
}
