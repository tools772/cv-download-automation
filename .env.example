# Supabase (same project as ATS portal)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # optional

# Only claim jobs for this portal user
COMPANION_PORTAL_USER_EMAIL=you@perfect.ventures

# Agent tuning
COMPANION_POLL_INTERVAL_MS=5000
COMPANION_HEARTBEAT_INTERVAL_MS=30000

# Platform login: use npm run login-instahyre / login-naukri (manual browser).
# Sessions saved under ~/PerfectVentures/ — no passwords in this file.
